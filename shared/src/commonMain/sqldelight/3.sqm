-- 3.sqm: version 3 -> 4. Push devices and the in-app activity list
-- (feature.pushNotifications).
CREATE TABLE Device (
    token TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    platform TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES User(guid) ON DELETE CASCADE
);
CREATE INDEX deviceUser ON Device(user_id);
CREATE TABLE Notification (
    guid TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    type TEXT NOT NULL,
    actor TEXT NOT NULL,
    post_guid TEXT,
    group_id TEXT,
    created_at TEXT NOT NULL,
    read_at TEXT,
    FOREIGN KEY (user_id) REFERENCES User(guid) ON DELETE CASCADE,
    FOREIGN KEY (post_guid) REFERENCES Post(guid) ON DELETE CASCADE,
    FOREIGN KEY (group_id) REFERENCES Groups(id) ON DELETE CASCADE
);
CREATE INDEX notificationUser ON Notification(user_id, created_at);
