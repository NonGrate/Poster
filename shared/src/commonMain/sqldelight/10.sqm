-- 10.sqm: version 10 -> 11. Two columns that turn a refresh token from a
-- rotating credential with no memory into one with a beginning and a history.
--
-- chain_started_at is when the person actually signed in. A rotation carries it
-- forward unchanged, so a thirty-day token that renews itself every day can no
-- longer live for ever: the absolute ceiling is measured from here.
--
-- used_at marks a token spent instead of deleting it. A spent token turning up
-- again is the signature of a copied one — the real owner rotated, the thief
-- replayed, or the other way round — and the only safe answer is to end every
-- session that account has. Rows are cleared once they are past the ceiling.
ALTER TABLE RefreshToken ADD COLUMN chain_started_at INTEGER NOT NULL DEFAULT 0;
ALTER TABLE RefreshToken ADD COLUMN used_at INTEGER;
