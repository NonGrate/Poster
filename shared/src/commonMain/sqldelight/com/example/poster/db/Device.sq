-- A device that can be pushed to (feature.pushNotifications). One row per
-- token; a token moves to whoever signed in last on that device.
CREATE TABLE Device (
    token TEXT NOT NULL PRIMARY KEY,
    user_id TEXT NOT NULL,
    platform TEXT NOT NULL,
    updated_at TEXT NOT NULL,
    FOREIGN KEY (user_id) REFERENCES User(guid) ON DELETE CASCADE
);
CREATE INDEX deviceUser ON Device(user_id);

upsertDevice:
INSERT OR REPLACE INTO Device(token, user_id, platform, updated_at)
VALUES (?, ?, ?, ?);

devicesForUser:
SELECT * FROM Device WHERE user_id = ?;

deleteDevice:
DELETE FROM Device WHERE token = ?;

-- Keeps the newest :keep devices for a person and drops the rest.
--
-- One account could register as many tokens as it liked, and every push then
-- fanned out to all of them — so a like on one post became as many outbound
-- calls as somebody had bothered to invent tokens. A person has a handful of
-- devices; the oldest rows are the ones they no longer use.
trimDevicesForUser:
DELETE FROM Device
WHERE user_id = :userId
  AND token NOT IN (
    SELECT token FROM Device
    WHERE user_id = :userId
    ORDER BY updated_at DESC
    LIMIT :keep
  );


-- Merging two accounts: the phones keep pushing, to the survivor. Keyed on
-- token, so nothing collides.
reassignDevices:
UPDATE Device SET user_id = :into WHERE user_id = :from;
