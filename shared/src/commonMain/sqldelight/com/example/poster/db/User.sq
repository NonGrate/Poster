CREATE TABLE User (
    guid TEXT NOT NULL PRIMARY KEY,
    name TEXT NOT NULL,
    surname TEXT NOT NULL,
    email TEXT NOT NULL UNIQUE,
    password_hash TEXT NOT NULL,
    photo TEXT,
    role TEXT NOT NULL DEFAULT 'user',
    status TEXT NOT NULL DEFAULT 'active',
    banned_at TEXT,
    banned_reason TEXT,
    -- Which languages this person wants to read, comma separated, and the one
    -- their own posts start in.
    languages TEXT NOT NULL DEFAULT 'en',
    default_language TEXT NOT NULL DEFAULT 'en',
    -- Null until they follow the link. Reading never requires it; writing does — see the server routes.
    verified_at TEXT,
    -- Off unless they opt in: whether their name is shown on a post's list of
    -- people liking it. 0/1.
    show_name INTEGER NOT NULL DEFAULT 0
);

-- The banned-author subquery every post query carries.
CREATE INDEX userStatus ON User(status);

-- Get all users
getAllUsers:
SELECT * FROM User;

-- Get user by ID
-- Device only: the author line a post arrived with (feature.authors). The
-- device has no accounts, so the row is a stub keyed by the guid; the guid
-- doubles as the unique email.
cacheAuthor:
INSERT OR IGNORE INTO User(guid, name, surname, email, password_hash)
VALUES (?, ?, '', ?, '');

updateAuthor:
UPDATE User SET name = ?, photo = ? WHERE guid = ?;

getUserById:
SELECT * FROM User
WHERE guid = ?;

-- Get user by email
-- Whose avatar an upload id is (feature.authors), for serving it.
getUserByPhoto:
SELECT * FROM User WHERE photo = ? LIMIT 1;

getUserByEmail:
SELECT * FROM User
WHERE email = ?;

-- Insert a new user
insertUser:
INSERT INTO User(guid, name, surname, email, password_hash, photo, role, status, languages, default_language, verified_at, show_name)
VALUES (?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?, ?);

-- Update user
updateUser:
UPDATE User
SET name = ?, surname = ?, email = ?, password_hash = ?, photo = ?, role = ?, status = ?,
    languages = ?, default_language = ?, verified_at = ?, show_name = ?
WHERE guid = ?;

-- Delete user
deleteUser:
DELETE FROM User
WHERE guid = ?;

deleteAllUsers:
DELETE FROM User;

-- Moderation
setRole:
UPDATE User SET role = ? WHERE guid = ?;

setStatus:
UPDATE User SET status = ?, banned_at = ?, banned_reason = ? WHERE guid = ?;

-- Following the link, and only that. Everything else about an account is
-- changed elsewhere.
markVerified:
UPDATE User SET verified_at = ? WHERE guid = ?;


-- The addresses of banned accounts, for deciding whether a registration is
-- the same inbox coming back. A short list by nature: everything else about
-- the user is irrelevant here, so only the address is read.
bannedEmails:
SELECT email FROM User WHERE status = 'banned';
