CREATE TABLE ModerationAudit (
    id TEXT NOT NULL PRIMARY KEY,
    actor_id TEXT NOT NULL,
    action TEXT NOT NULL,
    target_type TEXT NOT NULL,
    target_id TEXT NOT NULL,
    reason TEXT,
    created_at TEXT NOT NULL
);

record:
INSERT INTO ModerationAudit(id, actor_id, action, target_type, target_id, reason, created_at)
VALUES (?, ?, ?, ?, ?, ?, ?);

recent:
SELECT * FROM ModerationAudit ORDER BY created_at DESC LIMIT ?;

-- Account merge: keep audit actor pointing at the surviving account rather than
-- a deleted id. (Only actor is a guaranteed user id; target_id varies by type.)
reassignAuditActor:
UPDATE ModerationAudit SET actor_id = :into WHERE actor_id = :from;
