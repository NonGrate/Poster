# Poster server environment — copy to server/.env (git-ignored) and fill in.
# Every variable is optional except POSTER_JWT_SECRET outside development mode;
# an unset feature stays off or logs instead of sending. Where each value comes
# from: docs/Credentials.md. Behaviour and defaults: docs/Server.md.
#
#   docker run --env-file server/.env -v poster-data:/data -p 8080:8080 ghcr.io/<owner>/<repo>-server:main

# --- Always ------------------------------------------------------------------
POSTER_JWT_SECRET=                      # openssl rand -base64 48; keep stable across deploys
POSTER_BASE_URL=https://your.domain     # public origin used in email and admin links
PORT=8080
POSTER_DATABASE_PATH=/data/post.db
POSTER_UPLOADS_DIR=/data/uploads        # feature.images; same volume as the database
POSTER_FIXTURES_ENABLED=false           # never true in production: wipes the database on request

# --- Admin panel (/admin) ----------------------------------------------------
#POSTER_ADMIN_ENABLED=true
#POSTER_ADMIN_EMAIL=                    # an account that already exists in the app
#POSTER_ADMIN_SESSION_KEY=              # openssl rand -base64 48
#POSTER_ADMIN_INSECURE_COOKIE=false     # true only for plain-HTTP local runs

# --- Sign-in providers (feature.googleSignIn / feature.appleSignIn) ----------
#POSTER_GOOGLE_CLIENT_ID=               # Web id[,iOS id] — same as posterGoogleClientId / Local.xcconfig
#POSTER_APPLE_BUNDLE_ID=com.example.poster
#POSTER_APPLE_SERVICE_ID=               # same as posterAppleServiceId
#POSTER_APPLE_DOMAIN_ASSOCIATION=       # contents of apple-developer-domain-association.txt

# --- Email (Resend) ----------------------------------------------------------
#POSTER_RESEND_API_KEY=
#POSTER_MAIL_FROM="Poster <no-reply@your.domain>"

# --- Push notifications (feature.pushNotifications) --------------------------
#POSTER_FCM_PROJECT_ID=
#POSTER_FCM_SERVICE_ACCOUNT=/run/secrets/fcm.json
#POSTER_APNS_KEY_PATH=/run/secrets/apns.p8
#POSTER_APNS_KEY_ID=
#POSTER_APNS_TEAM_ID=
#POSTER_APNS_TOPIC=com.example.poster   # the iOS bundle id
#POSTER_APNS_SANDBOX=false              # true for development builds

# --- Deep links --------------------------------------------------------------
#POSTER_ANDROID_FINGERPRINTS=           # SHA-256 of the signing cert(s), comma-separated
#POSTER_ANDROID_PACKAGE=com.example.poster
#POSTER_APPLE_TEAM_ID=                  # enables apple-app-site-association

# --- Alerts, pages, purchases -----------------------------------------------
#POSTER_TELEGRAM_BOT_TOKEN=
#POSTER_TELEGRAM_CHAT_ID=
#POSTER_PAYMENTS_ENABLED=false          # true once you may take money (feature.support)
#POSTER_CONTACT_EMAIL=privacy@your.domain
#POSTER_SAFETY_CONTACT=
#POSTER_OWNER_NAME=
#POSTER_PLAY_URL=
#POSTER_APPSTORE_URL=
#POSTER_SITE_VERIFICATION=              # Google Search Console HTML-tag token

# --- Web app (feature.web) ---------------------------------------------------
#POSTER_WEB_ORIGINS=                    # extra CORS origins, comma-separated
#POSTER_WEB_DIR=                        # built Wasm bundle to serve at /app

# --- Backups (scripts/backup-database.sh) ------------------------------------
#POSTER_BACKUP_DIR=/data/backups
#POSTER_BACKUP_KEEP=14
#POSTER_BACKUP_UPLOAD=                  # e.g. rclone copyto {} remote:poster/
